#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# .git/hooks/pre-push — Auto-backup before every git push (branches only)
# ─────────────────────────────────────────────────────────────────────────────

REPO_DIR="$(git rev-parse --show-toplevel)"
BRANCH=$(git rev-parse --abbrev-ref HEAD)
SHA=$(git rev-parse --short HEAD)
DATE=$(date +%Y-%m-%d-%H%M)

# Read the refs being pushed — skip if pushing a tag (refs/tags/*)
while read local_ref local_sha remote_ref remote_sha; do
  # If pushing a tag, skip entirely (prevents infinite loop)
  if [[ "$local_ref" == refs/tags/* ]]; then
    exit 0
  fi
done

# Only auto-backup when pushing main or genspark_ai_developer branches
if [[ "$BRANCH" == "main" || "$BRANCH" == "genspark_ai_developer" ]]; then
  TAG="backup-${DATE}-${SHA}"
  echo ""
  echo "🔒  [pre-push] Auto-creating backup tag: $TAG"

  # Create the tag locally (quietly)
  git tag -a "$TAG" -m "Auto-backup before push | Branch: $BRANCH | Commit: $SHA" 2>/dev/null || true

  # Push tag separately without triggering this hook again
  # (use GIT_PUSH_OPTION to skip hook — not available in all versions,
  #  so we rely on the refs/tags/* guard above instead)
  GIT_DIR="$(git rev-parse --git-dir)" git push origin "$TAG" --no-verify 2>/dev/null && \
    echo "✅  Backup tag pushed: $TAG" || \
    echo "⚠️   Backup tag saved locally: $TAG (push manually with: git push origin $TAG)"
  echo ""
fi

exit 0
