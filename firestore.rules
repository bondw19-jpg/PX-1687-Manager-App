rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared store data ─────────────────────────────────────────────────────
    // Any authenticated (non-anonymous) user can read and write the shared
    // store collections. Only users with a real Firebase account (not demo).
    match /stores/{storeId}/{collection}/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Private per-user data ─────────────────────────────────────────────────
    // Only the owner (matching UID) can read or write their private notes
    // and calendar events.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
