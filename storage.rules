rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Note attachments — any authenticated user can read/write their own uploads
    // Path: noteAttachments/{scope}/{noteId}/{attachmentId}
    // scope = 'team' (shared) or 'my' (private)
    match /noteAttachments/team/{noteId}/{attachmentId} {
      allow read, write: if request.auth != null;
    }

    match /noteAttachments/my/{noteId}/{attachmentId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
