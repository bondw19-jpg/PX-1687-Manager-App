rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Team note attachments are shared with signed-in store users through Team Notes.
    // Path: noteAttachments/team/{noteId}/{attachmentId}
    match /noteAttachments/team/{noteId}/{attachmentId} {
      allow read, write: if request.auth != null;
    }

    // Private My Notes attachments are scoped by Firebase Auth UID.
    // Path: noteAttachments/my/{userId}/{noteId}/{attachmentId}
    match /noteAttachments/my/{userId}/{noteId}/{attachmentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy private attachment path used before UID scoping. New uploads must not
    // use this path because ownership cannot be proven from the object path alone.
    match /noteAttachments/my/{noteId}/{attachmentId} {
      allow read, write: if false;
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
